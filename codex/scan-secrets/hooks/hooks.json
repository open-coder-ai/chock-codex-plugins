{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.chock-sh=!sh\" chock-sh \"${PLUGIN_ROOT}/scripts/launch.sh\" \"${PLUGIN_ROOT}/scripts/codex_cli.py\" --gate \"${PLUGIN_ROOT}/scripts/gate.json\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.chock-sh=!sh\" chock-sh \"${PLUGIN_ROOT}/scripts/launch.sh\" \"${PLUGIN_ROOT}/scripts/codex_cli.py\" --gate \"${PLUGIN_ROOT}/scripts/gate.json\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
